{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "${CLOUDFLARE_ORIGIN}/$1",
      "env": ["CLOUDFLARE_ORIGIN"],
      "headers": {
        "Cache-Control": "no-store",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store",
        "x-vercel-enable-rewrite-caching": "0"
      },
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-origin-secret" },
          "args": "${HANGRONG_ORIGIN_SECRET}",
          "env": ["HANGRONG_ORIGIN_SECRET"]
        },
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-vercel-enable-rewrite-caching" },
          "args": "0"
        }
      ]
    }
  ]
}
