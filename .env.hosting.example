# Public deployment settings only. Copy to .env.hosting.local and fill in your account.
# Enter the shared VERCEL_ORIGIN_SECRET separately in Cloudflare/Vercel secret settings.
PUBLIC_SITE_ORIGIN=https://hangrong.vercel.app
CLOUDFLARE_WORKERS_SUBDOMAIN=YOUR_ACCOUNT_SUBDOMAIN
CLOUDFLARE_D1_DATABASE_ID=YOUR_DATABASE_UUID
CLOUDFLARE_D1_DATABASE_NAME=hangrong
CLOUDFLARE_WEBSITE_NAME=hangrong
CLOUDFLARE_REALTIME_NAME=hangrong-realtime
